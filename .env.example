# Copy to .env.local for development. Everything is optional locally:
# without Supabase the app uses data/dev-db.json, without Resend emails land in data/outbox/.

# Public URL of the site (used in email links). Vercel sets VERCEL_URL automatically as a fallback.
SITE_URL=http://localhost:3000

# Supabase: URL from the project's "Connect" dialog; key from Settings → API Keys → a secret key (sb_secret_…).
# The legacy service_role key also works but is deprecated by end of 2026. Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Weekly email is off unless this is "true" (then also set the Resend vars below).
EMAIL_ENABLED=false

# Resend → API Keys. EMAIL_FROM must be on a domain you've verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="DFW Coptic Calendar <calendar@example.org>"

# Bearer token the cloud agent uses for POST /api/ingest. Generate: openssl rand -hex 32
INGEST_SECRET=

# Vercel sends this as a Bearer token to cron routes. Generate: openssl rand -hex 32
CRON_SECRET=

# Password for /admin (reviewing submitted events).
ADMIN_PASSWORD=
